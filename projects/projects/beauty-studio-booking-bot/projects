{
  "name": "beauty-studio-booking-bot",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Запис у beauty studio",
        "formDescription": "Манікюр, педикюр і масаж. Залиште заявку, і майстер напише вам, щоб підібрати зручний час.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Імʼя",
              "placeholder": "Як до вас звертатися",
              "requiredField": true
            },
            {
              "fieldLabel": "Телефон",
              "placeholder": "+38 XXX XXX XX XX",
              "requiredField": true
            },
            {
              "fieldLabel": "Telegram (@нік)",
              "placeholder": "@nickname"
            },
            {
              "fieldLabel": "Послуга",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Манікюр" },
                  { "option": "Педикюр" },
                  { "option": "Масаж" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Коли зручно",
              "placeholder": "наприклад: будні після 15:00"
            },
            {
              "fieldLabel": "Коментар",
              "fieldType": "textarea",
              "placeholder": "Побажання, питання"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Надіслати заявку",
          "path": "beauty-booking"
        }
      },
      "id": "form-trigger",
      "name": "Форма запису",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [0, 0],
      "webhookId": "REPLACE_ME",
      "notes": "Public form for the studio booking flow."
    },
    {
      "parameters": {
        "jsCode": "const form = $('Форма запису').first().json;\nconst master = form.service === 'Масаж' ? 'Марія' : 'Ярослава';\nreturn { ...form, master, status: 'new', id: 'BOOKING_ID' };"
      },
      "id": "normalize-request",
      "name": "Нова заявка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "notes": "Normalizes the new booking and assigns the correct master."
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SHEET_ID",
          "cachedResultName": "Beauty studio bookings"
        },
        "sheetName": {
          "__rl": true,
          "mode": "id",
          "value": "BOOKINGS_SHEET_ID",
          "cachedResultName": "Bookings"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Дата": "={{ $json['Дата'] }}",
            "Час": "={{ $json['Час'] }}",
            "Процедура": "={{ $json['Процедура'] }}",
            "Майстер": "={{ $json['Майстер'] }}",
            "Імʼя": "={{ $json['Імʼя'] }}",
            "Телефон": "={{ $json['Телефон'] }}",
            "ID": "={{ $json['ID'] }}",
            "Статус": "={{ $json['Статус'] }}",
            "Telegram": "={{ $json['Telegram'] }}",
            "Chat ID клієнтки": "={{ $json['Chat ID клієнтки'] }}"
          },
          "schema": [
            { "id": "Дата", "displayName": "Дата", "required": false, "type": "string" },
            { "id": "Час", "displayName": "Час", "required": false, "type": "string" },
            { "id": "Процедура", "displayName": "Процедура", "required": false, "type": "string" },
            { "id": "Майстер", "displayName": "Майстер", "required": false, "type": "string" },
            { "id": "Імʼя", "displayName": "Імʼя", "required": false, "type": "string" },
            { "id": "Телефон", "displayName": "Телефон", "required": false, "type": "string" },
            { "id": "ID", "displayName": "ID", "required": false, "type": "string" },
            { "id": "Статус", "displayName": "Статус", "required": false, "type": "string" },
            { "id": "Telegram", "displayName": "Telegram", "required": false, "type": "string" },
            { "id": "Chat ID клієнтки", "displayName": "Chat ID клієнтки", "required": false, "type": "string" }
          ]
        },
        "options": {
          "cellFormat": "RAW"
        }
      },
      "id": "write-booking",
      "name": "Записати заявку",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [440, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Stores new bookings in the shared Google Sheet."
    },
    {
      "parameters": {
        "calendarId": "YOUR_CALENDAR_ID",
        "start": "={{ $json.start }}",
        "end": "={{ $json.end }}",
        "summary": "={{ $json.service }} | {{ $json.name }} | {{ $json.id }}",
        "description": "={{ $json.notes }}\nID: {{ $json.id }}\nMaster: {{ $json.master }}",
        "color": "11",
        "allDay": false,
        "options": {}
      },
      "id": "create-calendar-event",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [660, 0],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Calendar account"
        }
      },
      "notes": "Creates the shared calendar slot for the selected master."
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "send-message",
      "name": "Send Telegram message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "webhookId": "REPLACE_ME",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      },
      "notes": "Sends confirmation and admin messages."
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "prompt": "Parse a free-text beauty studio booking request and return JSON with name, service, date, time, notes, and phone.",
        "options": {
          "jsonMode": true
        }
      },
      "id": "groq-parse",
      "name": "Groq parse request",
      "type": "n8n-nodes-base.groq",
      "typeVersion": 1,
      "position": [220, 220],
      "credentials": {
        "groqApi": {
          "id": "REPLACE_ME",
          "name": "Groq account"
        }
      },
      "notes": "Parses free-text requests from clients."
    }
  ],
  "connections": {
