# Environment variables example for clinic-booking-bot

# Telegram bot token used by the workflow HTTP Request nodes (do not include the word `bot` in the value)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram chat id (numeric)
ADMIN_CHAT_ID=your_admin_chat_id_here

# Google Calendar id for the clinic calendar (ends with @group.calendar.google.com)
CALENDAR_ID=your_calendar_id_here@group.calendar.google.com

# Google Sheets document id (the long id from the sheet URL)
SHEET_ID=your_google_sheet_id_here

# n8n Data Table id for clinic_patients
DATA_TABLE_ID=your_data_table_id_here

# Clinic phone number used in messages (international format)
CLINIC_PHONE=+380700000000
